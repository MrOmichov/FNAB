# Godot 4+ specific ignores
.godot/
/android/

# Exported builds and local validation/user data.
/dist/
/.appdata/
export_credentials.cfg

# Local Android signing keys and credentials (never publish with source).
*.keystore
*.jks
*.p12
release-signing*.json

# Editor backups and temporary files (including Krita backups).
*~
*.bak
*.tmp

# Operating-system metadata.
.DS_Store
Thumbs.db
Desktop.ini

# Keep source assets, Godot *.import files and script *.uid files in Git.
